{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/MyPortifolio/",
        "http://localhost:4321/MyPortifolio/projetos/",
        "http://localhost:4321/MyPortifolio/projetos/predoctor/",
        "http://localhost:4321/MyPortifolio/experiencia/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/relatorios"
    }
  }
}
