---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center">
    <span class="mb-6 rounded-full border border-accent/40 bg-accent/10 px-4 py-1 text-xs font-medium tracking-wider text-accent uppercase">
      Em construção
    </span>
    <h1 class="text-4xl font-bold sm:text-5xl">
      Novo portfólio <span class="text-accent">em breve</span>
    </h1>
    <p class="mt-4 text-muted">Estou migrando este site para uma nova versão.</p>
  </section>
</BaseLayout>
