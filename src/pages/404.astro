---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout
  title="Página não encontrada"
  description="Esta página não existe ou mudou de endereço."
>
  <div class="section flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="text-7xl font-bold text-accent sm:text-8xl" aria-hidden="true">
      404
    </p>
    <h1 class="mt-4 text-2xl font-semibold sm:text-3xl">Página não encontrada</h1>
    <p class="mt-3 max-w-md text-muted">
      O endereço pode ter mudado ou não existir mais. Você pode voltar para a home ou ver os
      projetos.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={url('/')} class="btn-primary">
        Ir para a home
      </a>
      <a href={url('/projetos/')} class="btn-outline">
        Ver projetos
      </a>
    </div>
  </div>
</BaseLayout>
