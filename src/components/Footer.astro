---
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 pt-8 pb-24 text-center text-sm text-muted sm:flex-row sm:justify-between sm:px-6 sm:text-left lg:pb-8">
    <p>
      &copy; {year} <span class="text-accent">{site.name}</span>. Todos os direitos reservados.
    </p>
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:gap-6">
      <a href={url('/experiencia/')} class="transition-colors hover:text-accent">
        Experiência complementar
      </a>
      <SocialLinks size="sm" />
    </div>
  </div>
</footer>
