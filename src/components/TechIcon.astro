---
import { deviconSvg } from '../lib/icons';

interface Props {
  name: string;
  /** 'tile': ícone grande com o nome embaixo (seção Stack); 'chip': ícone pequeno e nome em linha. */
  variant?: 'tile' | 'chip';
}

const { name, variant = 'tile' } = Astro.props;
const svg = deviconSvg(name);
---

{svg && variant === 'tile' ? (
  <span class="inline-flex flex-col items-center gap-2 text-center" title={name}>
    <span class="size-9 text-muted transition-colors group-hover:text-accent [&>svg]:size-full">
      <Fragment set:html={svg} />
    </span>
    <span class="text-xs text-text/80">{name}</span>
  </span>
) : svg ? (
  <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white/[0.03] px-3 py-1 text-xs text-text/90">
    <span class="size-4 text-muted [&>svg]:size-full">
      <Fragment set:html={svg} />
    </span>
    {name}
  </span>
) : (
  <span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/15 px-3 py-1 text-xs font-medium text-chip">
    {name}
  </span>
)}
