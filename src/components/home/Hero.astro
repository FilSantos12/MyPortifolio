---
import { Image } from 'astro:assets';
import photo from '../../assets/filipe.png';
import { profile } from '../../data/profile';
import { socialSvg } from '../../lib/icons';
import { url } from '../../lib/url';
---

<section id="inicio" class="section flex min-h-[calc(100svh-4rem)] items-center overflow-x-clip">
  <div class="grid w-full items-center gap-12 md:grid-cols-[1.2fr_1fr] md:gap-16">
    <div>
      <span class="inline-block rounded-full border border-primary/40 bg-primary/15 px-4 py-1 text-xs font-medium tracking-wider text-chip uppercase">
        Disponível para projetos
      </span>

      <h1 class="mt-5 text-4xl leading-tight font-bold sm:text-5xl lg:text-6xl">
        Olá, eu sou
        <br />
        <span class="text-accent">Filipe Santos</span>
      </h1>

      <p class="mt-3 text-lg font-medium text-text">
        Desenvolvedor Full-Stack Web · Laravel + React/TypeScript
      </p>

      <p class="mt-4 max-w-xl leading-relaxed text-muted">
        Desenvolvo sistemas web completos, do planejamento ao deploy, com código testado, CI/CD e
        foco em resolver o problema do negócio.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={`${url('/')}#projetos`} class="btn-primary">
          Ver projetos
        </a>
        <a href={profile.links.cv} target="_blank" rel="noopener noreferrer" class="btn-outline">
          Baixar CV
          <span class="sr-only">(abre em nova aba)</span>
        </a>
        <a
          href={profile.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn border border-line text-text hover:border-accent/40 hover:bg-accent/10"
        >
          <span class="size-5 [&>svg]:size-full" set:html={socialSvg('github')} />
          GitHub
          <span class="sr-only">(abre em nova aba)</span>
        </a>
      </div>
    </div>

    <div class="relative order-first flex justify-center md:order-none">
      <!-- moldura tracejada girando, como no site anterior -->
      <div
        class="absolute top-1/2 left-1/2 h-[270px] w-[220px] -translate-x-1/2 -translate-y-1/2 sm:h-[340px] sm:w-[280px]"
        aria-hidden="true"
      >
        <div class="size-full animate-[spin_20s_linear_infinite] rounded-2xl border border-dashed border-accent/20"></div>
      </div>
      <Image
        src={photo}
        alt="Foto de Filipe Santos"
        widths={[200, 260, 400, 520]}
        sizes="(min-width: 640px) 260px, 200px"
        loading="eager"
        fetchpriority="high"
        class="relative h-[250px] w-[200px] rounded-2xl border border-line bg-white/[0.02] object-contain object-top shadow-[0_0_40px_rgb(72_49_212/0.25)] sm:h-[320px] sm:w-[260px]"
      />
    </div>
  </div>
</section>
